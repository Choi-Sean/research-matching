# Copy to `.env` (which is git-ignored) and fill in. Every value has a safe local default except DATABASE_URL in production.

ENVIRONMENT=development            # development | production

# --- Database ---------------------------------------------------------------------------------------------------------
# MSSQL. An ADO.NET string such as
#   Data Source=HOST;Initial Catalog=DBNAME;User Id=USER;Password=PASSWORD;Encrypt=True;TrustServerCertificate=True
# becomes
#   mssql+pytds://USER:PASSWORD@HOST:1433/DBNAME
# Percent-encode special characters in USER / PASSWORD:  @ -> %40   ! -> %21   : -> %3A   / -> %2F   # -> %23   % -> %25
# TLS is negotiated automatically and the certificate is not verified (that is what TrustServerCertificate=True means);
# add ?cafile=/path/to/ca.pem to verify it. Tables are created on first start (Base.metadata.create_all).
DATABASE_URL=mssql+pytds://USER:PASSWORD@HOST:1433/DBNAME
# Local SQLite for offline work:   DATABASE_URL=sqlite:///./dev.db

# --- Web / security -----------------------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000   # comma-separated
FRONTEND_URL=http://localhost:3000   # used in Stripe redirect URLs
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=10080
REQUIRE_EDU_EMAIL=true               # sign-up needs an academic e-mail (.edu, .edu.xx, .ac.xx)
ADMIN_EMAILS=                        # comma-separated; these accounts can open /admin
AUTO_VERIFY_PROFESSORS=false         # true = professors are verified on sign-up (development convenience only)
RATE_LIMIT_ENABLED=true
TALENT_SEARCHES_PER_DAY=30

# --- Scholarly data (OpenAlex) — works without a key; a contact e-mail gets you the faster "polite pool" -----------------
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# --- AI — without a key every AI feature falls back to the built-in rule-based engine ----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low                 # low | medium | high
ANTHROPIC_TIMEOUT_SECONDS=60

# --- Payments (Stripe, one-time Checkout). With no key, passes activate instantly so you can test ------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
